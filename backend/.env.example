# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# Os valores abaixo são apenas exemplos para desenvolvimento local
# (compatíveis com o docker-compose.yml) — não são credenciais reais.

# Porta HTTP da API NestJS
PORT=3000

# Banco PostgreSQL 18
POSTGRES_USER=restaurante
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=restaurante
POSTGRES_PORT=5432

# String de conexão usada pelo Prisma (CLI e @prisma/adapter-pg)
DATABASE_URL="postgresql://restaurante:troque-esta-senha@localhost:5432/restaurante?schema=public"
