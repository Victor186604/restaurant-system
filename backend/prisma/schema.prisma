// Modelo de dados do Sistema de Comandas e Pedidos para Restaurante.
// Documentação do Prisma Schema: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ==================================================
// Enums
// ==================================================

enum Perfil {
  GARCOM
  COZINHA
  GERENTE
}

enum StatusMesa {
  LIVRE
  OCUPADA
}

enum StatusComanda {
  ABERTA
  FECHAMENTO_SOLICITADO
  FECHADA
}

enum StatusPedido {
  PENDENTE
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

// ==================================================
// Models
// ==================================================

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(160)
  senhaHash String   @map("senha_hash")
  perfil    Perfil
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comandas Comanda[]

  @@map("usuarios")
}

model Mesa {
  id         Int        @id @default(autoincrement())
  numero     Int        @unique
  capacidade Int        @default(4)
  status     StatusMesa @default(LIVRE)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  comandas Comanda[]

  @@map("mesas")
}

model Categoria {
  id        Int      @id @default(autoincrement())
  nome      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(120)
  descricao   String?  @db.VarChar(500)
  preco       Decimal  @db.Decimal(10, 2)
  disponivel  Boolean  @default(true)
  categoriaId Int      @map("categoria_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoria Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  itens     ItemPedido[]

  @@index([categoriaId])
  @@map("produtos")
}

model Comanda {
  id                     Int           @id @default(autoincrement())
  mesaId                 Int           @map("mesa_id")
  usuarioId              Int?          @map("usuario_id")
  nomeCliente            String?       @map("nome_cliente") @db.VarChar(120)
  status                 StatusComanda @default(ABERTA)
  total                  Decimal?      @db.Decimal(10, 2)
  abertaEm               DateTime      @default(now()) @map("aberta_em")
  fechamentoSolicitadoEm DateTime?     @map("fechamento_solicitado_em")
  fechadaEm              DateTime?     @map("fechada_em")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  mesa    Mesa     @relation(fields: [mesaId], references: [id], onDelete: Restrict)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  pedidos Pedido[]

  @@index([mesaId])
  @@index([status])
  @@map("comandas")
}

model Pedido {
  id         Int          @id @default(autoincrement())
  comandaId  Int          @map("comanda_id")
  status     StatusPedido @default(PENDENTE)
  observacao String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  comanda Comanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  itens   ItemPedido[]

  @@index([comandaId])
  @@index([status])
  @@map("pedidos")
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  observacao    String? @db.VarChar(255)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido")
}
