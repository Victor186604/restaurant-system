# Copie este arquivo para .env e ajuste os valores.
# NUNCA versione o .env com credenciais reais.

# Conexão com o PostgreSQL 18.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Os valores abaixo correspondem ao docker-compose.yml deste diretório.
DATABASE_URL="postgresql://restaurante:restaurante@localhost:5432/restaurante?schema=public"

# Porta HTTP da API.
PORT=3000

# Origens permitidas para CORS, separadas por vírgula (usado pelos clientes web/mobile nas próximas etapas).
CORS_ORIGINS="http://localhost:3001"
