        {
          "name": "01 Listar mesas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mesas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mesas"
              ]
            }
          }
        },
        {
          "name": "02 Abrir comanda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comandas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comandas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesaId\": 3,\n  \"usuarioId\": 2,\n  \"nomeCliente\": \"Ana\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('comandaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Consultar comanda",
          "request": {
            "method": "GET",
            "header": [],
